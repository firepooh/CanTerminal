<Window x:Class="CanTerminal.App.LogProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opening log" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" Loaded="Window_Loaded" Closing="Window_Closing">
    <StackPanel Margin="16">
        <TextBlock x:Name="FileText" TextWrapping="Wrap" FontFamily="Consolas"/>
        <TextBlock x:Name="PhaseText" Margin="0,10,0,0" Foreground="#5E6B78"/>
        <ProgressBar x:Name="Bar" Height="14" Margin="0,6,0,0" Minimum="0" Maximum="100"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Width="80" Padding="0,4"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
