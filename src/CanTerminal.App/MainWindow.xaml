<Window x:Class="CanTerminal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CanTerminal — ValueCAN Monitor" Height="720" Width="1180"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- connection toolbar -->
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,5">
            <WrapPanel>
                <Label Content="Device:"/>
                <ComboBox x:Name="DeviceCombo" Width="230"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"/>
                <Label Content="Channels:"/>
                <TextBox x:Name="ChannelsBox" Width="90" Text="CAN1" ToolTip="Comma separated: CAN1,CAN2,CAN3,CAN4,MSCAN,SWCAN"/>
                <Label Content="Bitrate:"/>
                <ComboBox x:Name="BitrateCombo" Width="80" SelectedIndex="2">
                    <ComboBoxItem Content="125000"/>
                    <ComboBoxItem Content="250000"/>
                    <ComboBoxItem Content="500000"/>
                    <ComboBoxItem Content="1000000"/>
                </ComboBox>
                <CheckBox x:Name="FdCheck" Content="FD"/>
                <ComboBox x:Name="FdBitrateCombo" Width="80" SelectedIndex="0">
                    <ComboBoxItem Content="2000000"/>
                    <ComboBoxItem Content="5000000"/>
                    <ComboBoxItem Content="8000000"/>
                </ComboBox>
                <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" FontWeight="Bold"/>
                <Separator Width="12" Visibility="Hidden"/>
                <Button x:Name="DbcButton" Content="Load DBC…" Click="DbcButton_Click"/>
                <TextBlock x:Name="DbcLabel" VerticalAlignment="Center" Margin="4,0" Foreground="Gray" Text="(no DBC)"/>
                <Separator Width="12" Visibility="Hidden"/>
                <CheckBox x:Name="ServerCheck" Content="API server" IsChecked="True" Checked="ServerCheck_Changed" Unchecked="ServerCheck_Changed"/>
                <TextBox x:Name="PortBox" Width="55" Text="29536"/>
            </WrapPanel>
        </Border>

        <!-- TX + view toolbar -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,5" Background="#FAFAFA">
            <WrapPanel>
                <Label Content="TX:" FontWeight="Bold"/>
                <ComboBox x:Name="TxChannelCombo" Width="75"/>
                <Label Content="ID(hex):"/>
                <TextBox x:Name="TxIdBox" Width="80" Text="123" FontFamily="Consolas"/>
                <Label Content="Data(hex):"/>
                <TextBox x:Name="TxDataBox" Width="200" Text="00 11 22 33" FontFamily="Consolas"/>
                <CheckBox x:Name="TxExtCheck" Content="Ext"/>
                <CheckBox x:Name="TxFdCheck" Content="FD"/>
                <CheckBox x:Name="TxBrsCheck" Content="BRS"/>
                <Button x:Name="SendButton" Content="Send" Click="SendButton_Click"/>
                <Label Content="Cycle(ms):"/>
                <TextBox x:Name="TxCycleBox" Width="50" Text="100"/>
                <Button x:Name="PeriodicButton" Content="Start" Click="PeriodicButton_Click"/>
                <Separator Width="18" Visibility="Hidden"/>
                <RadioButton x:Name="TraceRadio" Content="Trace" IsChecked="True" VerticalAlignment="Center" Checked="ViewMode_Changed"/>
                <RadioButton x:Name="FixedRadio" Content="Fixed" Margin="8,0,0,0" VerticalAlignment="Center" Checked="ViewMode_Changed"/>
                <CheckBox x:Name="AutoScrollCheck" Content="Autoscroll" IsChecked="True"/>
                <CheckBox x:Name="HighlightCheck" Content="Highlight changes" IsChecked="True"
                          Unchecked="HighlightCheck_Changed"
                          ToolTip="In the Fixed view, briefly highlight data bytes whose value changed."/>
                <CheckBox x:Name="PauseCheck" Content="Pause"
                          ToolTip="Pauses the view; frames arriving while paused are not shown after resume (still queryable via recent / the TCP API)."/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"/>
                <Button x:Name="SaveButton" Content="Save CSV…" Click="SaveButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- protocol profile toolbar -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,5" Background="#F3F6FA">
            <WrapPanel>
                <Label Content="Profile:" FontWeight="Bold"/>
                <ComboBox x:Name="ProfileCombo" Width="90" SelectedIndex="0" SelectionChanged="Profile_Changed">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="XCP"/>
                </ComboBox>
                <StackPanel x:Name="XcpPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Label Content="Req ID(hex):"/>
                    <TextBox x:Name="XcpReqBox" Width="70" Text="701" FontFamily="Consolas"
                             ToolTip="CAN ID the master sends commands on (CMD)"/>
                    <Label Content="Rsp ID(hex):"/>
                    <TextBox x:Name="XcpRspBox" Width="70" Text="702" FontFamily="Consolas"
                             ToolTip="CAN ID the slave answers and sends DAQ-DTOs on (RES/DAQ)"/>
                    <Button x:Name="XcpApplyButton" Content="Apply" Click="XcpApply_Click"/>
                    <Button x:Name="XcpDetectButton" Content="Detect" Click="XcpDetect_Click"
                            ToolTip="Scan captured traffic for a CONNECT or GET_SLAVE_ID exchange. Sends nothing on the bus."/>
                    <Button x:Name="XcpA2lButton" Content="From A2L…" Click="XcpA2l_Click"
                            ToolTip="Read CAN_ID_MASTER / CAN_ID_SLAVE from an A2L file's IF_DATA XCP_ON_CAN block."/>
                    <CheckBox x:Name="XcpOnlyCheck" Content="XCP IDs only" VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="XcpOnly_Changed" Unchecked="XcpOnly_Changed"
                              ToolTip="Hide everything except the XCP request/response IDs. Applies to frames captured from now on; the Fixed view is reset."/>
                </StackPanel>
                <TextBlock x:Name="XcpStatusText" VerticalAlignment="Center" Margin="8,0" Foreground="Gray"/>
            </WrapPanel>
        </Border>

        <!-- trace view -->
        <ListView x:Name="TraceList" Grid.Row="3" FontFamily="Consolas" FontSize="12"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time [s]" Width="95" DisplayMemberBinding="{Binding Time}"/>
                    <GridViewColumn Header="Chan" Width="55" DisplayMemberBinding="{Binding Chan}"/>
                    <GridViewColumn Header="Dir" Width="38" DisplayMemberBinding="{Binding Dir}"/>
                    <GridViewColumn Header="ID" Width="80" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Flags" Width="70" DisplayMemberBinding="{Binding Flags}"/>
                    <GridViewColumn Header="DLC" Width="38" DisplayMemberBinding="{Binding Dlc}"/>
                    <GridViewColumn Header="Data" Width="300" DisplayMemberBinding="{Binding Data}"/>
                    <GridViewColumn Header="Frame type" Width="185" DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Comments" Width="460" DisplayMemberBinding="{Binding Decoded}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- fixed (aggregate) view -->
        <DataGrid x:Name="FixedGrid" Grid.Row="3" Visibility="Collapsed" AutoGenerateColumns="False"
                  IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                  EnableRowVirtualization="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Chan" Binding="{Binding Chan}" Width="60"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" SortMemberPath="SortKey" SortDirection="Ascending"/>
                <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="70"/>
                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"/>
                <DataGridTextColumn Header="Period [ms]" Binding="{Binding PeriodMs}" Width="90"/>
                <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="45"/>
                <!-- per-byte cells so a byte that just changed can carry its own fading highlight -->
                <DataGridTemplateColumn Header="Data" Width="300" SortMemberPath="DataText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Bytes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Background}" Margin="0,0,4,0" CornerRadius="2">
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Frame type" Binding="{Binding Type}" Width="185"/>
                <DataGridTextColumn Header="Comments" Binding="{Binding Decoded}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- status bar -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="ConnStatusText" Text="Disconnected" FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="RateText" Text="0 fps"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TotalText" Text="0 frames"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ServerStatusText" Text="API server: off"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="InfoText" Text="" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
