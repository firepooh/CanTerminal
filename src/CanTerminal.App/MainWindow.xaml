<Window x:Class="CanTerminal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CanTerminal.App"
        Title="CanTerminal — ValueCAN Monitor" Height="760" Width="1280"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Toolbar breathing room. Safe as implicit styles: nothing in the panes is harmed by
             a margin, and the data templates use TextBlock and Border rather than these. -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="7,1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- connection toolbar -->
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,5">
            <WrapPanel>
                <Label Content="Device:"/>
                <ComboBox x:Name="DeviceCombo" Width="230"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"/>
                <Label Content="Channels:"/>
                <TextBox x:Name="ChannelsBox" Width="140" Text="CAN1"
                         ToolTip="Comma separated: CAN1,CAN2,CAN3,CAN4,MSCAN,SWCAN&#10;Per-channel speed: NAME@bitrate[:fdbitrate], e.g. CAN1@500000,CAN2@125000&#10;Without @ the toolbar bitrate is used."/>
                <Label Content="Bitrate:"/>
                <ComboBox x:Name="BitrateCombo" Width="80" SelectedIndex="2">
                    <ComboBoxItem Content="125000"/>
                    <ComboBoxItem Content="250000"/>
                    <ComboBoxItem Content="500000"/>
                    <ComboBoxItem Content="1000000"/>
                </ComboBox>
                <CheckBox x:Name="FdCheck" Content="FD"/>
                <ComboBox x:Name="FdBitrateCombo" Width="80" SelectedIndex="0">
                    <ComboBoxItem Content="2000000"/>
                    <ComboBoxItem Content="5000000"/>
                    <ComboBoxItem Content="8000000"/>
                </ComboBox>
                <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" FontWeight="Bold"/>
                <Separator Width="12" Visibility="Hidden"/>
                <Button x:Name="DbcButton" Content="Load DBC…" Click="DbcButton_Click"/>
                <TextBlock x:Name="DbcLabel" VerticalAlignment="Center" Margin="4,0" Foreground="Gray" Text="(no DBC)"/>
                <Separator Width="12" Visibility="Hidden"/>
                <CheckBox x:Name="ServerCheck" Content="API server" IsChecked="True" Checked="ServerCheck_Changed" Unchecked="ServerCheck_Changed"/>
                <TextBox x:Name="PortBox" Width="55" Text="29536"/>
            </WrapPanel>
        </Border>

        <!-- TX + view toolbar -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,5" Background="#FAFAFA">
            <WrapPanel>
                <Label Content="TX:" FontWeight="Bold"/>
                <ComboBox x:Name="TxChannelCombo" Width="75"/>
                <Label Content="ID(hex):"/>
                <TextBox x:Name="TxIdBox" Width="80" Text="123" FontFamily="Consolas"/>
                <Label Content="Data(hex):"/>
                <TextBox x:Name="TxDataBox" Width="200" Text="00 11 22 33" FontFamily="Consolas"/>
                <CheckBox x:Name="TxExtCheck" Content="Ext"/>
                <CheckBox x:Name="TxFdCheck" Content="FD"/>
                <CheckBox x:Name="TxBrsCheck" Content="BRS"/>
                <Button x:Name="SendButton" Content="Send" Click="SendButton_Click"/>
                <Label Content="Cycle(ms):"/>
                <TextBox x:Name="TxCycleBox" Width="50" Text="100"/>
                <Button x:Name="PeriodicButton" Content="Start" Click="PeriodicButton_Click"/>
                <Separator Width="18" Visibility="Hidden"/>
                <Label Content="Layout:"/>
                <ComboBox x:Name="LayoutCombo" Width="115" SelectedIndex="0" SelectionChanged="Layout_Changed"
                          ToolTip="Single keeps one merged view, which preserves the true cross-channel time order.&#10;Split shows two panes, each with its own channel and view mode.">
                    <ComboBoxItem Content="Single"/>
                    <ComboBoxItem Content="Split ↔"/>
                    <ComboBoxItem Content="Split ↕"/>
                </ComboBox>
                <Label Content="History:"/>
                <TextBox x:Name="HistoryBox" Width="60" Text="50000" LostFocus="History_Changed"
                         ToolTip="Trace rows kept per pane (min 100). Once full the oldest row is overwritten in place."/>
                <CheckBox x:Name="AutoScrollCheck" Content="Autoscroll" IsChecked="True"/>
                <CheckBox x:Name="HighlightCheck" Content="Highlight changes" IsChecked="True"
                          Unchecked="HighlightCheck_Changed"
                          ToolTip="In the Fixed view, briefly highlight data bytes whose value changed."/>
                <CheckBox x:Name="PauseCheck" Content="Pause"
                          ToolTip="Pauses the view; frames arriving while paused are not shown after resume (still queryable via recent / the TCP API)."/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"/>
                <Button x:Name="SaveButton" Content="Save CSV…" Click="SaveButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- protocol profile toolbar -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,5" Background="#F3F6FA">
            <WrapPanel>
                <Label Content="Profile:" FontWeight="Bold"/>
                <ComboBox x:Name="ProfileCombo" Width="90" SelectedIndex="0" SelectionChanged="Profile_Changed">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="XCP"/>
                </ComboBox>
                <StackPanel x:Name="XcpPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <Label Content="Channel:"/>
                    <ComboBox x:Name="XcpChannelCombo" Width="80" SelectionChanged="XcpChannel_Changed"
                              ToolTip="One XCP session per channel: a 2-port master uses a different CAN ID pair on each."/>
                    <Label Content="Req(hex):"/>
                    <TextBox x:Name="XcpReqBox" Width="75" Text="701" FontFamily="Consolas"
                             ToolTip="CAN ID the master sends commands on (CMD)"/>
                    <Label Content="Rsp(hex):"/>
                    <TextBox x:Name="XcpRspBox" Width="75" Text="702" FontFamily="Consolas"
                             ToolTip="CAN ID the slave answers and sends DAQ-DTOs on (RES/DAQ)"/>
                    <Button x:Name="XcpApplyButton" Content="Set" Click="XcpApply_Click"
                            ToolTip="Configure the session for the selected channel."/>
                    <Button x:Name="XcpRemoveButton" Content="Remove" Click="XcpRemove_Click"
                            ToolTip="Drop the session on the selected channel."/>
                    <Button x:Name="XcpDetectButton" Content="Detect all" Click="XcpDetect_Click"
                            ToolTip="Scan captured traffic for CONNECT or GET_SLAVE_ID exchanges and configure every channel found. Sends nothing on the bus."/>
                    <Button x:Name="XcpA2lButton" Content="From A2L…" Click="XcpA2l_Click"
                            ToolTip="Read CAN_ID_MASTER / CAN_ID_SLAVE from IF_DATA XCP_ON_CAN. Select several files (p1, p2, …) to configure several channels at once."/>
                    <CheckBox x:Name="XcpOnlyCheck" Content="XCP IDs only" VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="XcpOnly_Changed" Unchecked="XcpOnly_Changed"
                              ToolTip="Hide everything except the configured XCP IDs. Applies to frames captured from now on; the Fixed view is reset."/>
                </StackPanel>
                <TextBlock x:Name="XcpStatusText" VerticalAlignment="Center" Margin="8,0" Foreground="Gray"/>
            </WrapPanel>
        </Border>

        <!-- one or two panes; row/column definitions are set by ApplyLayout -->
        <Grid x:Name="PaneHost" Grid.Row="3">
            <local:ChannelPane x:Name="PaneA"/>
            <GridSplitter x:Name="PaneSplitter" Background="#CCC" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <local:ChannelPane x:Name="PaneB" Visibility="Collapsed"/>
        </Grid>

        <!-- status bar -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="ConnStatusText" Text="Disconnected" FontWeight="Bold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="RateText" Text="0 fps"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TotalText" Text="0 frames"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ServerStatusText" Text="API server: off"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="InfoText" Text="" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
