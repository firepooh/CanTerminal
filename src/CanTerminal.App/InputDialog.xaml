<Window x:Class="CanTerminal.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"/>
        <TextBox x:Name="ValueBox" Margin="0,9,0,0" Padding="4,3" FontFamily="Consolas"/>
        <TextBlock x:Name="HintText" Margin="0,7,0,0" Foreground="#5E6B78" TextWrapping="Wrap" FontSize="11.5"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Padding="0,4" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Padding="0,4" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
