<Window x:Class="CanTerminal.App.ChannelAssignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Foreground="#5E6B78" FontSize="11.5"
                   Margin="0,0,0,12"/>

        <Grid x:Name="Rows">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock x:Name="HintText" Margin="0,10,0,0" Foreground="#5E6B78" TextWrapping="Wrap" FontSize="11.5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Padding="0,4" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Padding="0,4" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
